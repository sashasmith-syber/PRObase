{
  "name": "ait-professor-1.1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:bff\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:bff": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "build:desktop": "npm run build && electron-builder --linux dir",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:scan-secrets": "node scripts/scan-secrets.mjs",
    "security:check-rotation": "node scripts/check-rotation.mjs",
    "build:analyze": "npm run build && node scripts/check-chunk-size.mjs",
    "ci:validate": "npm run typecheck && npm run test && npm run security:check-rotation && npm run build:analyze"
  },
  "dependencies": {
    "@google/genai": "^1.8.0",
    "dotenv": "^18.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "typescript": "~5.8.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "latest"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.aitprofessor.desktop",
    "productName": "AIT PROfessor",
    "executableName": "ait-professor",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Education"
    }
  }
}
