# ─────────────────────────────────────────────
# Frontend (.env or .env.local in project root)
# ─────────────────────────────────────────────

# Your Google Gemini API key (used directly only when NOT running through the Worker)
GEMINI_API_KEY=your_gemini_api_key_here

# URL of your deployed Cloudflare Worker (defaults to localhost:8787 in dev)
VITE_WORKER_URL=http://localhost:8787

# ─────────────────────────────────────────────
# Worker secrets — set via wrangler CLI, NOT here
# ─────────────────────────────────────────────
# wrangler secret put STRIPE_SECRET_KEY   → sk_test_... or sk_live_...
# wrangler secret put STRIPE_PRICE_ID     → price_...
# wrangler secret put GEMINI_API_KEY      → your Gemini API key
#
# Set in worker/wrangler.toml [vars]:
# ALLOWED_ORIGIN = "https://your-production-domain.com"
