# Environment template for AIT PROfessor AI.
# Copy to `.env.local` for local development.

# Local BFF runtime secret (used by `server/index.mjs`).
GEMINI_API_KEY=REPLACE_WITH_REAL_KEY
BFF_PORT=8787

# Optional security policy values for Safe Bubble and key metadata.
KEY_MAX_AGE_DAYS=90
API_KEY_VERSION_GEMINI=v1
API_KEY_ROTATION_DATE_GEMINI=2026-01-01

# Browser-side guardrails (non-secret policy controls).
VITE_SAFE_BUBBLE_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
VITE_SAFE_BUBBLE_MAX_TOKENS=4096
VITE_SAFE_BUBBLE_MAX_PAYLOAD_SIZE=250000
VITE_SAFE_BUBBLE_RATE_LIMIT_WINDOW_MS=60000
VITE_SAFE_BUBBLE_RATE_LIMIT_MAX_REQUESTS=30

# Only use this if you explicitly run direct browser provider mode.
# Preferred mode is backend-only (`/api/gemini/chat`) with server secrets.
VITE_GEMINI_API_KEY=REPLACE_WITH_REAL_KEY
