# ─── AIT PROfessor — Environment Template ───
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (*.local) and MUST NOT be committed.

# Google Gemini API key (required for AI chat functionality)
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Safe Bubble proxy (Phase 2+) ───
# SAFE_BUBBLE_PORT=4000
# SAFE_BUBBLE_ORIGIN_ALLOWLIST=http://localhost:3000
# SAFE_BUBBLE_RATE_LIMIT_PER_MIN=30
# SAFE_BUBBLE_RATE_LIMIT_PER_DAY=500
# SAFE_BUBBLE_LOG_DIR=safe-bubble/logs
